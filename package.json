{
  "name": "seatmap-js",
  "version": "0.1.2",
  "description": "A modular venue seating map editor and embeddable PixiJS renderer.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:editor": "vite --host 0.0.0.0 --port 8000",
    "build:editor": "vite build",
    "dev:renderer": "pnpm --filter @seatmap-js/renderer dev",
    "build:renderer": "pnpm --filter @seatmap-js/renderer build",
    "build:renderer-pages": "pnpm build:renderer && node scripts/build-renderer-pages.mjs",
    "preview:renderer": "pnpm --filter @seatmap-js/renderer preview",
    "pack:renderer": "pnpm --filter @seatmap-js/renderer publish --dry-run --no-git-checks",
    "test": "pnpm build:editor && pnpm build:renderer && pnpm pack:renderer"
  },
  "keywords": [
    "seatmap",
    "venue",
    "seating",
    "pixi",
    "canvas",
    "renderer"
  ],
  "author": "Arturo Castillo",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturocastillo95/SeatMap-JS.git"
  },
  "bugs": {
    "url": "https://github.com/arturocastillo95/SeatMap-JS/issues"
  },
  "homepage": "https://github.com/arturocastillo95/SeatMap-JS#readme",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@turf/helpers": "6.5.0",
    "@turf/union": "6.5.0",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  }
}
