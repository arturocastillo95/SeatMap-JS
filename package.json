{
  "name": "seatmap-js",
  "version": "0.1.2",
  "description": "A modular venue seating map editor and embeddable PixiJS renderer.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev:editor": "vite --host 0.0.0.0 --port 8000",
    "build:editor": "vite build",
    "dev:renderer": "pnpm --filter @seatmap-js/renderer dev",
    "build:renderer": "pnpm --filter @seatmap-js/renderer build",
    "build:renderer-pages": "pnpm build:renderer && node scripts/build-renderer-pages.mjs",
    "preview:renderer": "pnpm --filter @seatmap-js/renderer preview",
    "pack:renderer": "node scripts/verify-renderer-package.mjs",
    "audit:renderer-map": "node renderer/bin/audit-map.js",
    "test": "pnpm test:unit && pnpm build:editor && pnpm build:renderer && pnpm pack:renderer",
    "test:unit": "node --test renderer/tests/*.test.js",
    "test:browser": "pnpm build:renderer-pages && pnpm --filter @seatmap-js/renderer test:browser"
  },
  "keywords": [
    "seatmap",
    "venue",
    "seating",
    "pixi",
    "canvas",
    "renderer"
  ],
  "author": "Arturo Castillo",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturocastillo95/SeatMap-JS.git"
  },
  "bugs": {
    "url": "https://github.com/arturocastillo95/SeatMap-JS/issues"
  },
  "homepage": "https://github.com/arturocastillo95/SeatMap-JS#readme",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@turf/helpers": "6.5.0",
    "@turf/union": "6.5.0",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.3",
    "vite": "^7.2.4"
  }
}
