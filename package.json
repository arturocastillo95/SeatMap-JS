{
  "name": "seatmap-js",
  "version": "0.1.2",
  "description": "A modular venue seating map editor and embeddable PixiJS renderer.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:editor": "vite --host 0.0.0.0 --port 8000",
    "build:editor": "vite build",
    "dev:renderer": "npm --prefix renderer run dev",
    "build:renderer": "npm --prefix renderer run build",
    "preview:renderer": "npm --prefix renderer run preview",
    "pack:renderer": "npm pack --workspace @seatmap-js/renderer --dry-run --cache /tmp/seatmap-npm-cache",
    "test": "npm run build:editor && npm run build:renderer && npm run pack:renderer"
  },
  "workspaces": [
    "renderer"
  ],
  "keywords": [
    "seatmap",
    "venue",
    "seating",
    "pixi",
    "canvas",
    "renderer"
  ],
  "author": "Arturo Castillo",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arturocastillo95/SeatMap-JS.git"
  },
  "bugs": {
    "url": "https://github.com/arturocastillo95/SeatMap-JS/issues"
  },
  "homepage": "https://github.com/arturocastillo95/SeatMap-JS#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@turf/helpers": "6.5.0",
    "@turf/union": "6.5.0",
    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "vite": "^7.2.4"
  }
}
